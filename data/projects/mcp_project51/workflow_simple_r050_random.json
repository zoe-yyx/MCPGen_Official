{
  "workflow": {
    "name": "User Review Aggregation",
    "description": "Automated Amazon review monitoring: scrape → sentiment → summarize → store → alert.",
    "type": "mcp_workflow",
    "version": "1.0.0",
    "origin": "ENDPOINT_PLACEHOLDER",
    "tags": [
      "reviews",
      "sentiment",
      "amazon",
      "automation"
    ]
  },
  "configuration": {
    "mock_mode": true,
    "environment_variables": {
      "AZURE_OPENAI_ENDPOINT": {
        "required": false,
        "description": "Azure OpenAI endpoint URL",
        "example": "ENDPOINT_PLACEHOLDER"
      },
      "AZURE_OPENAI_API_KEY": {
        "required": false,
        "description": "Azure OpenAI API key"
      },
      "AZURE_OPENAI_API_VERSION": {
        "required": false,
        "description": "API version",
        "example": "2024-02-01"
      },
      "AZURE_SENTIMENT_DEPLOYMENT": {
        "required": false,
        "description": "Deployment name for sentiment analysis",
        "example": "gpt-4o-mini"
      },
      "AZURE_SUMMARY_DEPLOYMENT": {
        "required": false,
        "description": "Deployment name for summarization",
        "example": "gpt-4o"
      },
      "DECODO_API_KEY": {
        "required": false,
        "description": "Decodo scraper API key (only for real mode)"
      },
      "TELEGRAM_BOT_TOKEN": {
        "required": false,
        "description": "Telegram Bot token for alert notifications"
      },
      "TELEGRAM_CHAT_ID": {
        "required": false,
        "description": "Telegram chat/group ID to send alerts to"
      },
      "URL_CSV_PATH": {
        "required": false,
        "description": "Path to CSV file containing product URLs",
        "example": "data/urls.csv"
      },
      "RESULTS_CSV_PATH": {
        "required": false,
        "description": "Path to output CSV file for aggregated results",
        "example": "results/outputs/review_aggregations.csv"
      }
    }
  },
  "workflow_steps": [
    {
      "step_id": "1",
      "name": "get_urls_from_csv",
      "type": "source",
      "description": "Read product URLs from local CSV. Replaces Google Sheets node.",
      "mcp_tool": "tool_get_urls_from_csv",
      "parameters": {
        "input": {
          "csv_path": "data/urls.csv",
          "url_column": "url"
        }
      },
      "next_steps": []
    },
    {
      "step_id": "3",
      "name": "format_reviews",
      "type": "transform",
      "description": "Transform raw Decodo JSON into clean author-rating-content text blocks.",
      "mcp_tool": "tool_format_reviews",
      "parameters": {
        "input": {
          "decodo_response": "{{ step_2.result }}",
          "source_url": "{{ step_1.urls[i] }}"
        }
      },
      "next_steps": []
    },
    {
      "step_id": "6",
      "name": "summarize_reviews",
      "type": "ai_analysis",
      "description": "Generate a concise executive summary of all reviews via Azure OpenAI.",
      "mcp_tool": "tool_summarize_reviews",
      "parameters": {
        "input": {
          "reviews": "{{ step_3.reviews }}",
          "azure_endpoint": "{{ env.AZURE_OPENAI_ENDPOINT }}",
          "api_key": "{{ env.AZURE_OPENAI_API_KEY }}",
          "deployment_name": "{{ env.AZURE_SUMMARY_DEPLOYMENT }}",
          "mock_mode": true
        }
      },
      "next_steps": [
        "7"
      ]
    },
    {
      "step_id": "7",
      "name": "send_alert",
      "type": "notification",
      "description": "Send alert to log / JSONL file and optionally to Telegram. Replaces Telegram node.",
      "mcp_tool": "tool_send_alert",
      "parameters": {
        "input": {
          "url": "{{ step_3.url }}",
          "sentiment": "{{ step_4.sentimentAnalysis.category }}",
          "summary_text": "{{ step_6.output.text }}",
          "telegram_bot_token": "{{ env.TELEGRAM_BOT_TOKEN }}",
          "telegram_chat_id": "{{ env.TELEGRAM_CHAT_ID }}",
          "alert_sentiments": "[\"positive\",\"neutral\",\"negative\"]"
        }
      },
      "next_steps": []
    }
  ]
}